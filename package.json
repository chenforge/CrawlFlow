{
  "name": "crawlflow",
  "productName": "CrawlFlow",
  "version": "1.2.0",
  "description": "面向零代码用户的 Windows 可视化网页采集工具",
  "author": "CrawlFlow",
  "private": true,
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  },
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "npm run build && electron .",
    "test": "node --test tests/*.test.cjs electron/schedules.test.cjs",
    "prepare:runtime": "node -e \"require('electron')\"",
    "package": "npm run build && npm run prepare:runtime && electron-builder --win portable --x64",
    "package:installer": "npm run build && npm run prepare:runtime && electron-builder --win nsis --x64",
    "package:release": "npm run build && npm run prepare:runtime && electron-builder --win portable nsis --x64",
    "package:dir": "npm run build && npm run prepare:runtime && electron-builder --win --x64 --dir"
  },
  "dependencies": {
    "exceljs": "4.4.0",
    "lucide-react": "^0.468.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "latest",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "playwright": "latest",
    "vite": "8.3.2"
  },
  "build": {
    "appId": "local.crawlflow.desktop",
    "productName": "CrawlFlow",
    "artifactName": "CrawlFlow-${version}-Windows-x64.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!electron/**/*.test.cjs",
      "build/icon.ico",
      "package.json"
    ],
    "asar": true,
    "npmRebuild": false,
    "electronDist": "node_modules/electron/dist",
    "toolsets": {
      "nsis": "1.2.1"
    },
    "win": {
      "target": [
        "portable"
      ],
      "signExecutable": false,
      "icon": "build/icon.ico",
      "executableName": "CrawlFlow"
    },
    "portable": {
      "requestExecutionLevel": "user"
    },
    "nsis": {
      "include": "build/installer.nsh",
      "artifactName": "CrawlFlow-${version}-Setup-x64.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CrawlFlow",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ],
      "language": "2052"
    }
  }
}
